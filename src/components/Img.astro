---
import { photos } from '../data/site';
const { id, sizes = '(min-width: 900px) 50vw, 100vw', eager = false, class: cls = '' } = Astro.props;
const p = photos[id];
const src = (w: number) => `/img/${p.slug}-${w}.webp`;
---
<img
  class={cls}
  src={src(900)}
  srcset={`${src(480)} 480w, ${src(900)} 900w, ${src(1600)} 1600w`}
  sizes={sizes}
  width={p.w}
  height={p.h}
  alt={p.alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
/>
