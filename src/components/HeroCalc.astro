---
// Mini-kalkulator w nagłówku strony głównej: wynik od razu, telefon opcjonalnie (prośba o oddzwonienie).
// Wysyła na /api/contact z type=callback (functions/api/contact.ts).
import { pricing } from '../data/site';
---
<div class="hc" id="hc" data-foil={pricing.foilPerM2} data-cov={pricing.coverage} data-ctrl={pricing.controllerPerRoom}>
  <p class="hc__title">Ile kosztuje folia w Twoim domu?</p>
  <div class="hc__inputs">
    <label class="fl">Powierzchnia (m²)<input id="hc-m2" name="area" type="number" min="1" step="1" value="100" inputmode="numeric" /></label>
    <label class="fl">Pomieszczenia<input id="hc-rooms" name="rooms" type="number" min="1" step="1" value="5" inputmode="numeric" /></label>
  </div>
  <div class="hc__res" aria-live="polite">
    <span>Orientacyjnie, folia + sterowniki</span>
    <strong id="hc-total">–</strong>
  </div>
  <form id="hc-form" action="/api/contact" method="post" novalidate>
    <p class="hc__ask">Chcesz dokładną wycenę? <b>Oddzwonimy tego samego dnia roboczego.</b></p>
    <div class="hc__inputs">
      <label class="fl">Telefon<input name="phone" type="tel" required autocomplete="tel" placeholder="np. 600 100 200" /></label>
      <label class="fl">Imię<input name="name" autocomplete="given-name" placeholder="opcjonalnie" /></label>
    </div>
    <input type="hidden" name="type" value="callback" />
    <input type="hidden" name="area" id="hc-area" />
    <input type="hidden" name="rooms" id="hc-rooms-h" />
    <input type="hidden" name="estimate" id="hc-est" />
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="consent"><input type="checkbox" name="consent" required />
      <span>Zgadzam się na kontakt telefoniczny w sprawie wyceny. <a href="/polityka-prywatnosci">Polityka prywatności</a></span></label>
    <button class="btn" type="submit">Oddzwońcie do mnie</button>
    <small class="hc__hours">Pn–Pt 9:00–17:00. Zgłoszenia po 17:00 i w weekend – następnego dnia roboczego.</small>
    <div class="form-msg" id="hc-msg" role="status" aria-live="polite"></div>
  </form>
</div>
<script>
  const el = document.getElementById('hc')!;
  const foil = +el.dataset.foil!, cov = +el.dataset.cov!, ctrl = +el.dataset.ctrl!;
  const m2 = document.getElementById('hc-m2') as HTMLInputElement;
  const rooms = document.getElementById('hc-rooms') as HTMLInputElement;
  const out = document.getElementById('hc-total')!;
  // Ta sama formuła co installCost/pln w src/data/site.ts (zaokrąglenie do 100 zł)
  const fmt = (n: number) => new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 0 }).format(Math.round(n / 100) * 100) + ' zł';
  const calc = () => {
    const a = Math.max(0, parseFloat(m2.value) || 0), r = Math.max(0, parseInt(rooms.value) || 0);
    const total = a * cov * foil + r * ctrl;
    out.textContent = a > 0 ? 'ok. ' + fmt(total) : '–';
    (document.getElementById('hc-area') as HTMLInputElement).value = a ? String(a) : '';
    (document.getElementById('hc-rooms-h') as HTMLInputElement).value = r ? String(r) : '';
    (document.getElementById('hc-est') as HTMLInputElement).value = a > 0 ? out.textContent! : '';
  };
  m2.addEventListener('input', calc); rooms.addEventListener('input', calc); calc();

  // reCAPTCHA v3 ładowana dopiero przy pierwszej interakcji z formularzem (nie spowalnia strony głównej)
  const siteKey = '6LfaCQUuAAAAAEm8vlKjLJvKJUoOaCr5lwRxRHZt';
  type G = { ready(cb: () => void): void; execute(k: string, o: { action: string }): Promise<string> };
  let loading: Promise<void> | undefined;
  const loadRecaptcha = () => {
    const w = window as unknown as { grecaptcha?: G };
    if (w.grecaptcha) return Promise.resolve();
    loading ??= new Promise<void>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = `https://www.google.com/recaptcha/api.js?render=${siteKey}`;
      s.async = true; s.onload = () => resolve(); s.onerror = () => { loading = undefined; reject(new Error('recaptcha')); };
      document.head.appendChild(s);
    });
    return loading;
  };
  const form = document.getElementById('hc-form') as HTMLFormElement;
  const msg = document.getElementById('hc-msg')!;
  form.addEventListener('focusin', () => { void loadRecaptcha().catch(() => {}); }, { once: true });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.className = 'form-msg';
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    phone.setCustomValidity(phone.value.replace(/\D/g, '').length >= 9 ? '' : 'Podaj numer telefonu (min. 9 cyfr).');
    if (!form.reportValidity()) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Wysyłanie…';
    try {
      await loadRecaptcha();
      const g = (window as unknown as { grecaptcha?: G }).grecaptcha;
      if (!g) throw new Error('recaptcha');
      const token = await new Promise<string>((res, rej) => g.ready(() => g.execute(siteKey, { action: 'callback' }).then(res, rej)));
      const data = new FormData(form);
      data.set('recaptchaToken', token);
      const r = await fetch(form.action, { method: 'POST', body: data });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.ok) throw new Error(j.error || 'error');
      form.reset(); calc();
      msg.className = 'form-msg ok';
      msg.textContent = 'Dziękujemy! Oddzwonimy tego samego dnia roboczego.';
      (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: 'callback_request' });
    } catch {
      msg.className = 'form-msg err';
      msg.innerHTML = 'Nie udało się wysłać. Zadzwoń: <a href="tel:+48668173872">+48 668 173 872</a>.';
    } finally { btn.disabled = false; btn.textContent = 'Oddzwońcie do mnie'; }
  });
</script>
