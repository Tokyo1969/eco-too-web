---
import { site } from '../data/site';
const { title = 'Planujesz ogrzewanie domu lub mieszkania?', text = 'Podaj metraż, liczbę pomieszczeń i rodzaj podłogi. Powiemy, czy folia grzewcza ma sens w Twoim budynku, i przygotujemy wstępną wycenę.', btn = 'Poproś o wycenę' } = Astro.props;
---
<section class="cta">
  <div class="wrap">
    <div class="cta__copy">
      <h2>{title}</h2>
      <p>{text}</p>
      <p class="contact-line"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="btn-row">
      <a class="btn" href="/kontakt#formularz">{btn}</a>
      <a class="btn ghost" href={site.phoneHref}>Zadzwoń: {site.phone}</a>
    </div>
  </div>
</section>
