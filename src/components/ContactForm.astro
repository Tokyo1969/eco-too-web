---
---
<form class="f" id="contact-form" method="post" action="/api/contact" novalidate>
  <label class="fl">Imię i nazwisko<input name="name" required autocomplete="name" /></label>
  <label class="fl">Numer telefonu<input name="phone" type="tel" required autocomplete="tel" /></label>
  <label class="fl">Adres e-mail<input name="email" type="email" required autocomplete="email" /></label>
  <label class="fl">Miejscowość inwestycji<input name="city" required /></label>
  <label class="fl">Rodzaj obiektu
    <select name="object" required>
      <option value="">— wybierz —</option>
      <option>Dom jednorodzinny</option><option>Mieszkanie</option><option>Domek letniskowy</option>
      <option>Biuro / gabinet</option><option>Lokal usługowy</option><option>Inny</option>
    </select>
  </label>
  <label class="fl">Powierzchnia do ogrzania (m²)<input name="area" inputmode="decimal" /></label>
  <label class="fl">Etap inwestycji
    <select name="stage">
      <option value="">— wybierz —</option>
      <option>Planowanie / projekt</option><option>Budowa</option><option>Remont</option><option>Gotowy budynek</option>
    </select>
  </label>
  <label class="fl">Planowane wykończenie podłogi
    <select name="floor">
      <option value="">— wybierz —</option>
      <option>Panele laminowane</option><option>Panele winylowe</option><option>Deski warstwowe</option>
      <option>Płytki ceramiczne</option><option>Inne / jeszcze nie wiem</option>
    </select>
  </label>
  <label class="fl full">Wiadomość <span class="opt">(opcjonalnie)</span><textarea name="message"></textarea></label>
  <p class="full note" style="margin:0">Rzut lub projekt (PDF, zdjęcie) możesz dosłać odpowiadając na naszą wiadomość lub wysyłając go na <a href="mailto:biuro@eco-too.opole.pl">biuro@eco-too.opole.pl</a>.</p>
  <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <label class="consent full"><input type="checkbox" name="consent" required />
    <span>Wyrażam zgodę na przetwarzanie moich danych w celu odpowiedzi na zapytanie, zgodnie z <a href="/polityka-prywatnosci">polityką prywatności</a>.</span></label>
  <div class="full"><button class="btn" type="submit">Poproś o kontakt</button></div>
  <div class="full form-msg" id="form-msg" role="status" aria-live="polite"></div>
</form>
<script>
  const recaptchaSiteKey = '6LfaCQUuAAAAAEm8vlKjLJvKJUoOaCr5lwRxRHZt';
  const recaptchaScriptUrl = `https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`;

  interface Grecaptcha {
    ready(callback: () => void): void;
    execute(siteKey: string, options: { action: string }): Promise<string>;
  }

  declare global {
    interface Window { grecaptcha?: Grecaptcha }
  }

  let recaptchaScript: Promise<void> | undefined;
  function loadRecaptcha(): Promise<void> {
    if (window.grecaptcha) return Promise.resolve();
    if (!recaptchaScript) {
      recaptchaScript = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = recaptchaScriptUrl;
        script.async = true;
        script.defer = true;
        script.onload = () => resolve();
        script.onerror = () => {
          recaptchaScript = undefined;
          reject(new Error('recaptcha_load_failed'));
        };
        document.head.appendChild(script);
      });
    }
    return recaptchaScript;
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const msg = document.getElementById('form-msg')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.className = 'full form-msg';
    if (!form.reportValidity()) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Wysyłanie…';
    try {
      await loadRecaptcha();
      const recaptcha = window.grecaptcha;
      if (!recaptcha) throw new Error('recaptcha_unavailable');
      const token = await new Promise<string>((resolve, reject) => {
        recaptcha.ready(() => {
          recaptcha.execute(recaptchaSiteKey, { action: 'contact' }).then(resolve, reject);
        });
      });
      const formData = new FormData(form);
      formData.set('recaptchaToken', token);
      const res = await fetch(form.action, { method: 'POST', body: formData });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || 'error');
      form.reset();
      msg.className = 'full form-msg ok';
      msg.textContent = 'Dziękujemy! Wiadomość została wysłana. Odezwiemy się w godzinach pracy (Pn–Pt 9:00–17:00).';
    } catch {
      msg.className = 'full form-msg err';
      msg.innerHTML = 'Nie udało się wysłać formularza. Napisz na <a href="mailto:biuro@eco-too.opole.pl">biuro@eco-too.opole.pl</a> lub zadzwoń: <a href="tel:+48668173872">+48 668 173 872</a>.';
    } finally { btn.disabled = false; btn.textContent = 'Poproś o kontakt'; }
  });
</script>
