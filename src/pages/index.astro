---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import CTA from '../components/CTA.astro';
import Gallery from '../components/Gallery.astro';
import { cities, pln, exampleCost } from '../data/site';
// ikony liniowe 24×24 (obrys currentColor)
const benefits = [
  ['<path d="M7 3c1.5 1.5 1.5 3 0 4.5S5.5 10.5 7 12s1.5 3 0 4.5S5.5 19.5 7 21M12 3c1.5 1.5 1.5 3 0 4.5S10.5 10.5 12 12s1.5 3 0 4.5-1.5 3 0 4.5M17 3c1.5 1.5 1.5 3 0 4.5S15.5 10.5 17 12s1.5 3 0 4.5-1.5 3 0 4.5"/>', 'Komfort cieplny', 'Ciepło rozprowadzane jest na dużej powierzchni, bez konieczności instalowania tradycyjnych grzejników.'],
  ['<path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/>', 'Więcej miejsca we wnętrzu', 'Instalacja może zostać ukryta pod podłogą, w suficie lub w ścianie. Dzięki temu nie ogranicza możliwości aranżacji pomieszczeń.'],
  ['<path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/>', 'Sterowanie temperaturą', 'Każda strefa może być wyposażona w osobny termostat. Pozwala to ustawić temperaturę odpowiednią dla danego pomieszczenia i sposobu jego użytkowania.'],
  ['<path d="M11 5 6 9H2v6h4l5 4V5zM22 9l-6 6M16 9l6 6"/>', 'Cicha praca', 'System nie wykorzystuje wentylatorów ani elementów mechanicznych, dlatego pracuje bezgłośnie.'],
  ['<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>', 'Brak kotłowni i spalin', 'Ogrzewanie elektryczne nie wymaga składowania opału, komina ani wydzielania osobnego pomieszczenia na kocioł.'],
  ['<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>', 'Współpraca z fotowoltaiką', 'Folia grzewcza może być elementem instalacji wykorzystującej energię elektryczną produkowaną przez panele fotowoltaiczne.'],
];
const offer = [
  ['/ogrzewanie-podlogowe', 'Ogrzewanie podłogowe', 'Folie grzewcze montowane pod odpowiednio dobraną warstwą wykończeniową zapewniają przyjemnie ciepłą podłogę i równomierne ogrzewanie wnętrza.', 'Dowiedz się więcej'],
  ['/ogrzewanie-sufitowe-i-scienne', 'Ogrzewanie sufitowe', 'Rozwiązanie odpowiednie między innymi tam, gdzie konstrukcja lub planowane wykończenie podłogi utrudnia wykonanie ogrzewania podłogowego.', 'Poznaj możliwości'],
  ['/ogrzewanie-sufitowe-i-scienne#sciany', 'Ogrzewanie ścienne', 'System może być zamontowany w wybranych fragmentach ścian. Sprawdza się jako ogrzewanie podstawowe lub uzupełniające, zależnie od parametrów budynku.', 'Zapytaj o rozwiązanie'],
];
const process = [
  ['Rozmowa i analiza potrzeb', 'Poznajemy budynek, planowane wykończenie oraz oczekiwania dotyczące komfortu i sterowania.'],
  ['Dobór systemu', 'Określamy odpowiedni sposób montażu, rozmieszczenie folii, moc instalacji i podział na strefy.'],
  ['Przejrzysta wycena', 'Przedstawiamy zakres prac oraz koszt realizacji. Wyjaśniamy, jakie przygotowanie będzie potrzebne przed montażem.'],
  ['Profesjonalny montaż', 'Instalujemy system zgodnie z przygotowanym projektem i wymaganiami technicznymi.'],
  ['Sprawdzenie i uruchomienie', 'Kontrolujemy instalację, konfigurujemy sterowanie oraz przekazujemy wskazówki dotyczące użytkowania.'],
];
const quick = [
  ['Szybki montaż na sucho', 'Bez rur, wylewek do wysychania i kucia. Pod panelami podłogę można układać zaraz po ułożeniu folii.'],
  ['Niski koszt instalacji', `Bez kotła, komina i instalacji wodnej. Orientacyjnie ok. ${pln(exampleCost)} za 100 m² z termostatami w 5 pokojach.`],
  ['Bez serwisu i opału', 'Brak części ruchomych, palnika i przeglądów kotła. Współpracuje z fotowoltaiką.'],
];
const uses = ['domach jednorodzinnych', 'mieszkaniach i apartamentach', 'domkach letniskowych', 'biurach', 'gabinetach', 'lokalach usługowych', 'obiektach przeznaczonych na wynajem', 'wybranych obiektach komercyjnych'];
---
<Base
  title="Folie grzewcze Opole – montaż ogrzewania | ECO-TOO"
  description="Folie grzewcze na podczerwień – Opole i woj. opolskie. Alternatywne, tanie w instalacji ogrzewanie bez kotłowni i komina. Szybki montaż na sucho."
>
  <section class="hero">
    <div class="hero__copy">
      <span class="kicker">ECO-TOO · Opole i województwo opolskie</span>
      <h1><span class="hero__slogan">Ciepło, które <em class="em">pokochasz</em></span> <span class="hero__sub">Folie grzewcze na podczerwień w województwie opolskim</span></h1>
      <p class="lead">Nowoczesne i wygodne ogrzewanie elektryczne do domów, mieszkań, biur oraz lokali użytkowych.</p>
      <p class="more-text">Projektujemy i montujemy systemy ogrzewania podłogowego, sufitowego i ściennego oparte na foliach grzewczych. Zapewniamy kompleksową obsługę — od doboru rozwiązania i przygotowania wyceny aż po profesjonalny montaż i uruchomienie instalacji.</p>
      <div class="btn-row">
        <a class="btn" href="/kontakt#formularz">Poproś o wycenę</a>
        <a class="btn ghost" href="#jak-to-dziala">Zobacz, jak to działa</a>
      </div>
      <small>Obsługujemy klientów z Opola oraz całego województwa opolskiego.</small>
    </div>
    <div class="hero__photo"><Img id="hero-folia" sizes="(min-width: 860px) 50vw, 100vw" eager /></div>
  </section>

  <section class="block">
    <div class="wrap">
      <span class="kicker">Dlaczego folia grzewcza</span>
      <h2>Komfortowe ciepło dopasowane do Twojego wnętrza</h2>
      <p class="intro">Folia grzewcza zamienia energię elektryczną w ciepło przekazywane przez promieniowanie podczerwone. Ogrzewa powierzchnie znajdujące się w pomieszczeniu, a następnie pomaga utrzymać przyjemną i równomierną temperaturę.</p>
      <h3 style="margin:var(--space-7) 0 var(--space-5)">Dlaczego warto rozważyć ogrzewanie folią grzewczą?</h3>
      <div class="grid g3">
        {benefits.map(([i, t, d]) => <div class="card"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={i} /></div><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="block dark">
    <div class="wrap">
      <span class="kicker">Szybko i bez kotłowni</span>
      <h2>Alternatywne ogrzewanie, tanie w instalacji</h2>
      <div class="grid g3" style="margin-top:var(--space-6)">
        {quick.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}
      </div>
      <div class="btn-row">
        <a class="btn" href="/koszty-ogrzewania-elektrycznego">Sprawdź koszty</a>
        <a class="btn ghost" href="/ogrzewanie-alternatywne">Porównaj z pompą ciepła i piecem</a>
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <span class="kicker">Oferta</span>
      <h2>Dobieramy ogrzewanie do budynku i potrzeb użytkowników</h2>
      <p class="intro">Nie ma jednego rozwiązania odpowiedniego dla każdego obiektu. Przed przygotowaniem oferty analizujemy między innymi powierzchnię pomieszczeń, standard izolacji, rodzaj wykończenia podłogi oraz oczekiwany sposób sterowania.</p>
      <div class="grid g3" style="margin-top:var(--space-7)">
        {offer.map(([h, t, d, b]) => <a class="card link" href={h}><h3>{t}</h3><p>{d}</p><span class="more">{b} →</span></a>)}
      </div>
      <div style="margin-top:var(--space-6)">
        <h3>Możliwe także ułożenie podłogi</h3>
        <p>We współpracy z wykonawcą możesz zlecić również montaż paneli, desek lub innej podłogi. Wstępna cena montażu to 44 zł netto/m²; ostateczna zależy od materiału, sposobu ułożenia oraz wykończenia listwami. Szczegóły ustalisz bezpośrednio z wykonawcą. <a href="/jak-wyglada-realizacja">Poznaj szczegóły i zadzwoń</a> lub <a href="/kontakt#formularz">zaznacz zainteresowanie w formularzu</a>.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap split">
      <div>
        <span class="kicker">Zastosowania</span>
        <h2>Gdzie montujemy folie grzewcze?</h2>
        <p>Wykonujemy instalacje w nowych i modernizowanych obiektach:</p>
        <ul class="checks">{uses.map((u) => <li>{u}</li>)}</ul>
        <p style="margin-top:var(--space-5)">Każdy system projektujemy indywidualnie. Przed realizacją sprawdzamy warunki techniczne oraz możliwości montażu.</p>
        <a class="btn dark" href="/zastosowania">Zobacz zastosowania</a>
      </div>
      <Img id="drogoszow-6" />
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <span class="kicker">Lokalnie</span>
      <h2>Montaż folii grzewczych w Opolu i całym województwie opolskim</h2>
      <p class="intro">Realizujemy instalacje między innymi w {cities.join(', ')} i okolicznych miejscowościach.</p>
      <ul class="chips">{['Opole','Kędzierzyn-Koźle','Nysa','Brzeg','Kluczbork','Prudnik','Strzelce Opolskie','Namysłów','Krapkowice','Głubczyce','Olesno'].map((c) => <li>{c}</li>)}</ul>
      <p style="margin-top:var(--space-5)">Pełna lista powiatów i miejscowości: <a href="/obszar-dzialania">obszar działania</a>. Nie widzisz swojej miejscowości? <a href="/kontakt">Skontaktuj się z nami</a> i zapytaj o możliwość realizacji.</p>
    </div>
  </section>

  <section class="block dark" id="jak-to-dziala">
    <div class="wrap">
      <span class="kicker">Jak pracujemy</span>
      <h2>Od konsultacji do ciepłego wnętrza</h2>
      <ol class="steps">{process.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ol>
    </div>
  </section>

  <section class="block">
    <div class="wrap split">
      <div>
        <span class="kicker">O firmie</span>
        <h2>Ogrzewanie zaprojektowane na lata</h2>
        <p>W ECO-TOO stawiamy na rzetelne doradztwo, staranny montaż i rozwiązania dopasowane do konkretnego budynku. Nie sprzedajemy gotowego schematu. Najpierw sprawdzamy potrzeby klienta i warunki techniczne, a dopiero później rekomendujemy odpowiedni system.</p>
        <p>Klient otrzymuje jasne informacje dotyczące zakresu prac, sposobu sterowania oraz zasad bezpiecznego użytkowania instalacji.</p>
        <a class="btn dark" href="/o-firmie">Poznaj naszą firmę</a>
      </div>
      <Img id="zestaw" sizes="(min-width: 900px) 40vw, 90vw" />
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <span class="kicker">Realizacje</span>
      <h2>Zobacz nasze realizacje</h2>
      <p class="intro">Prezentujemy wybrane instalacje wykonane w domach, mieszkaniach i lokalach na terenie województwa opolskiego.</p>
      <div style="margin:var(--space-7) 0 var(--space-5)"><Gallery ids={['drogoszow-1','pustkow-5','dobrzen-3','ochodze-1','drogoszow-3','dobrzen-1']} /></div>
      <a class="btn dark" href="/realizacje">Zobacz realizacje</a>
    </div>
  </section>

  <section class="block">
    <div class="wrap split">
      <div>
        <span class="kicker">Kalkulator</span>
        <h2>Sprawdź orientacyjny koszt</h2>
        <p>Podaj powierzchnię i liczbę pomieszczeń, a kalkulator pokaże przybliżony koszt folii i sterowników. To punkt wyjścia do rozmowy — konkretną ofertę przygotujemy po analizie budynku.</p>
        <a class="btn" href="/kalkulator">Otwórz kalkulator</a>
      </div>
      <Img id="folia-rolka" sizes="(min-width: 900px) 40vw, 90vw" />
    </div>
  </section>

  <CTA />
</Base>
