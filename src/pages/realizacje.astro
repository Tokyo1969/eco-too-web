---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import CTA from '../components/CTA.astro';
import { projects, projectUrl, site } from '../data/site';
---
<Base
  breadcrumbs={[['Realizacje', '/realizacje']]}
  title="Realizacje ogrzewania folią grzewczą – Opolskie | ECO-TOO"
  description="Zdjęcia z realizacji ogrzewania na podczerwień w województwie opolskim – folie i maty grzewcze w domach: Pustków k. Ozimka, Drogoszów, Ochodze, Dobrzeń Wielki."
>
  <div class="page-hero"><div class="wrap">
    <span class="kicker">Realizacje</span>
    <h1>Nasze realizacje</h1>
    <p>Instalacje w domach, mieszkaniach i lokalach w województwie opolskim. Przy każdej realizacji podajemy liczbę stref, sposób sterowania i szacowany roczny koszt ogrzewania.</p>
  </div></div>
  {projects.map((p, i) => (
    <section class={`block ${i % 2 ? 'alt' : ''}`} id={p.id}>
      <div class="wrap">
        <h2 class="h-md"><a href={projectUrl(p.id)}>{p.place}</a></h2>
        <div class="proj-meta"><span>{p.type}</span><span>Folia grzewcza na podczerwień</span></div>
        <p class="intro" style="margin-bottom:1.6rem">{p.note}</p>
        <Gallery ids={p.photos.slice(0, 3)} />
        <div class="btn-row"><a class="btn dark" href={projectUrl(p.id)}>Parametry i wszystkie zdjęcia ({p.photos.length}) →</a></div>
      </div>
    </section>
  ))}
  <section class="block"><div class="wrap" style="text-align:center">
    <h2 class="h-md">Montowaliśmy u Ciebie ogrzewanie?</h2>
    <p class="intro" style="margin-inline:auto">Twoja opinia w Google pomaga innym mieszkańcom Opolszczyzny w wyborze ogrzewania. Dziękujemy!</p>
    <div class="btn-row" style="justify-content:center"><a class="btn dark" href={site.reviewUrl} rel="noopener" target="_blank">Wystaw opinię w Google</a></div>
  </div></section>
  <CTA title="Chcesz podobną instalację?" text="Opowiedz nam o swoim domu lub mieszkaniu. Dobierzemy folię i podział na strefy tak jak w realizacjach powyżej." />
</Base>
