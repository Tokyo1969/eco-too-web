---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import CTA from '../components/CTA.astro';
import { projects } from '../data/site';
---
<Base
  breadcrumbs={[['Realizacje', '/realizacje']]}
  title="Realizacje ogrzewania folią grzewczą – Opolskie | ECO-TOO"
  description="Zdjęcia z realizacji ogrzewania na podczerwień w województwie opolskim – folie i maty grzewcze w domach: Pustków k. Ozimka, Drogoszów, Ochodze, Dobrzeń Wielki."
>
  <div class="page-hero"><div class="wrap">
    <span class="kicker">Realizacje</span>
    <h1>Nasze realizacje</h1>
    <p>Wybrane instalacje wykonane w domach na terenie województwa opolskiego. Kliknij zdjęcie, aby je powiększyć.</p>
  </div></div>
  {projects.map((p, i) => (
    <section class={`block ${i % 2 ? 'alt' : ''}`} id={p.id}>
      <div class="wrap">
        <h2 style="font-size:2.2rem">{p.place}</h2>
        <div class="proj-meta"><span>{p.type}</span><span>Folia grzewcza na podczerwień</span></div>
        <p class="intro" style="margin-bottom:1.2rem">{p.note}</p>
        {p.facts && <ul class="checks" style="margin-bottom:1.6rem">{p.facts.map((f) => <li>{f}</li>)}</ul>}
        {!p.facts && <div style="margin-bottom:1.6rem"></div>}
        <Gallery ids={p.photos} />
      </div>
    </section>
  ))}
  <CTA title="Chcesz podobną instalację?" text="Opowiedz nam o swoim domu lub mieszkaniu. Sprawdzimy możliwości montażu i przygotujemy propozycję." />
</Base>
