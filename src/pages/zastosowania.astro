---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
const items = [
  ['Ogrzewanie elektryczne domu jednorodzinnego', 'System może stanowić ogrzewanie podstawowe w odpowiednio przygotowanym energetycznie budynku lub ogrzewanie wybranych pomieszczeń. Szczególne znaczenie mają izolacja, zapotrzebowanie na ciepło i prawidłowo dobrana moc.'],
  ['Ogrzewanie mieszkania folią grzewczą', 'Folia grzewcza pozwala zrezygnować z widocznych grzejników i sterować temperaturą niezależnie w poszczególnych pokojach. Przed montażem sprawdzamy możliwości techniczne oraz moc przyłączeniową.'],
  ['Ogrzewanie podłogowe do remontu', 'Niewielka grubość elementów systemu może ułatwiać jego zastosowanie podczas modernizacji. Ostateczny układ warstw zawsze dobieramy do istniejącej konstrukcji.'],
  ['Ogrzewanie domku letniskowego i obiektów użytkowanych okresowo', 'Programowalne lub zdalne sterowanie umożliwia utrzymywanie temperatury minimalnej i ogrzanie wnętrza przed przyjazdem.'],
  ['Ogrzewanie biura i lokalu usługowego na podczerwień', 'Podział instalacji na strefy pozwala dopasować temperaturę do godzin pracy i sposobu wykorzystania poszczególnych pomieszczeń.'],
];
---
<Base
  breadcrumbs={[['Zastosowania', '/zastosowania']]}
  title="Zastosowania folii grzewczych – domy, mieszkania, biura | ECO-TOO"
  description="Gdzie sprawdza się ogrzewanie na podczerwień: domy jednorodzinne, mieszkania, remonty, domki letniskowe, biura i lokale usługowe w Opolskiem."
>
  <div class="page-hero"><div class="wrap">
    <span class="kicker">Zastosowania</span>
    <h1>Gdzie sprawdza się ogrzewanie folią</h1>
    <p>Każdy system projektujemy indywidualnie – od mieszkania po lokal usługowy.</p>
  </div></div>
  <section class="block"><div class="wrap grid g2">
    {items.map(([t, d]) => <div class="card"><h3>{t}</h3><p>{d}</p></div>)}
  </div></section>
  <CTA />
</Base>
