---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
const items = [
  ['Ogrzewanie elektryczne domu jednorodzinnego', 'W dobrze ocieplonym domu folia może być głównym ogrzewaniem, w słabiej ocieplonym ogrzewać wybrane pomieszczenia. Moc dobieramy do zapotrzebowania budynku na ciepło. Przykład: dom ok. 180 m² w Starych Budkowicach, 13 stref.'],
  ['Ogrzewanie mieszkania folią grzewczą', 'Bez grzejników na ścianach, z osobnym termostatem w każdym pokoju. Przed montażem sprawdzamy instalację elektryczną i moc przyłączeniową mieszkania.'],
  ['Ogrzewanie podłogowe do remontu', 'Folia ma ułamek milimetra grubości, więc zwykle mieści się pod nową podłogą. Układ warstw dobieramy do istniejącej konstrukcji. Przykład: prawie 100-letni dom w Drogoszowie.'],
  ['Ogrzewanie domku letniskowego i obiektów użytkowanych okresowo', 'Ze sterowaniem przez telefon utrzymasz temperaturę minimalną pod nieobecność i ogrzejesz domek przed przyjazdem.'],
  ['Ogrzewanie biura i lokalu usługowego na podczerwień', 'Każda strefa grzeje według godzin pracy danego pomieszczenia. Przykład: salon kosmetyczny w Opolu, ok. 24 m².'],
];
---
<Base
  breadcrumbs={[['Zastosowania', '/zastosowania']]}
  title="Zastosowania folii grzewczych – domy, mieszkania, biura | ECO-TOO"
  description="Gdzie sprawdza się ogrzewanie na podczerwień: domy jednorodzinne, mieszkania, remonty, domki letniskowe, biura i lokale usługowe w Opolskiem."
>
  <div class="page-hero"><div class="wrap">
    <span class="kicker">Zastosowania</span>
    <h1>Gdzie sprawdza się ogrzewanie folią</h1>
    <p>Od pokoju na poddaszu po cały dom i lokal usługowy.</p>
  </div></div>
  <section class="block"><div class="wrap grid g2">
    {items.map(([t, d]) => <div class="card"><h3>{t}</h3><p>{d}</p></div>)}
  </div></section>
  <CTA />
</Base>
