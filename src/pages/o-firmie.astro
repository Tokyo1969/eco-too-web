---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import CTA from '../components/CTA.astro';
const why = ['indywidualny dobór systemu','przejrzysty zakres prac','bezpośredni kontakt z wykonawcą','staranny montaż','sprawdzone komponenty','pomoc w konfiguracji sterowania','obsługa posprzedażowa','doświadczenie potwierdzone realizacjami'];
---
<Base
  title="O firmie ECO-TOO – lokalny wykonawca ogrzewania na podczerwień"
  description="ECO-TOO projektuje i montuje elektryczne systemy grzewcze z folii na podczerwień w Opolu i województwie opolskim. Poznaj naszą firmę."
>
  <div class="page-hero"><div class="wrap">
    <span class="kicker">O firmie</span>
    <h1>Lokalna firma, bezpośredni kontakt</h1>
  </div></div>
  <section class="block"><div class="wrap split">
    <div>
      <p>ECO-TOO specjalizuje się w projektowaniu i montażu elektrycznych systemów grzewczych opartych na foliach na podczerwień. Działamy na terenie Opola i województwa opolskiego.</p>
      <p>Naszym celem jest wykonanie instalacji dopasowanej do rzeczywistych potrzeb użytkowników oraz parametrów budynku. Dlatego każdą współpracę rozpoczynamy od zebrania informacji i oceny warunków technicznych.</p>
      <h2 style="font-size:1.9rem;margin-top:1.4rem">Dlaczego klienci wybierają ECO-TOO?</h2>
      <ul class="checks">{why.map((w) => <li>{w}</li>)}</ul>
    </div>
    <Img id="dobrzen-3" sizes="(min-width: 900px) 35vw, 80vw" />
  </div></section>
  <CTA title="Porozmawiajmy o Twoim ogrzewaniu" text="Napisz lub zadzwoń – ocenimy możliwości techniczne i zaproponujemy kolejne kroki." btn="Skontaktuj się" />
</Base>
