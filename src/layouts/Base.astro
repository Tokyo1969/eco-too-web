---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import TagManager from '../components/TagManager.astro';
import { site, nav, areas, services } from '../data/site';
// breadcrumbs: [['Nazwa', '/sciezka'], ...] – bez strony głównej, dodawana automatycznie
const { title, description, path = Astro.url.pathname, noindex = false, ogImage = '/img/drogoszow-1-1600.webp', schema = null, breadcrumbs = null } = Astro.props;
const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), site.url).href;
const local = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  alternateName: 'ECO-TOO Opole',
  legalName: site.legalName,
  sameAs: site.profiles,
  hasMap: site.profiles[0],
  description: 'Projektowanie i montaż ogrzewania na podczerwień w Opolu i województwie opolskim – folie grzewcze podłogowe, sufitowe i ścienne, maty grzewcze. Alternatywne ogrzewanie elektryczne bez kotłowni i komina.',
  slogan: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  taxID: site.NIP,
  image: `${site.url}/img/drogoszow-1-1600.webp`,
  logo: `${site.url}/logo.png`,
  priceRange: '$$',
  currenciesAccepted: 'PLN',
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.postal, addressLocality: site.city, addressRegion: 'opolskie', addressCountry: 'PL' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Województwo opolskie' },
    ...[...new Set(areas.flatMap((a) => a.places.map((p) => p.split(' – ')[0])))].map((name) => ({ '@type': 'City', name })),
  ],
  knowsAbout: ['folia grzewcza', 'ogrzewanie na podczerwień', 'ogrzewanie podłogowe elektryczne', 'ogrzewanie sufitowe', 'ogrzewanie ścienne', 'maty grzewcze', 'ogrzewanie alternatywne', 'fotowoltaika i ogrzewanie elektryczne'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Ogrzewanie na podczerwień',
    itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.desc, url: `${site.url}${s.path}` } })),
  },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '09:00', closes: '17:00' }],
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, inLanguage: 'pl-PL', publisher: { '@id': `${site.url}/#business` } };
const crumbs = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [['Strona główna', '/'], ...breadcrumbs].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(p, site.url).href })),
};
const ld = [local, website, ...(crumbs ? [crumbs] : []), ...(schema ? [schema].flat() : [])];
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <TagManager />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#1a120c" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site.url).href} />
  <meta property="og:image:alt" content={title} />
  <meta name="geo.region" content="PL-OP" />
  <meta name="geo.placename" content="Opole" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <a class="skip" href="#main">Przejdź do treści</a>
  <div class="topbar"><div class="wrap">
    <span>Opole i województwo opolskie · {site.hours}</span>
    <span><a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></span>
  </div></div>
  <header class="site"><div class="wrap">
    <a class="brand" href="/" aria-label="ECO-TOO – strona główna"><img src="/logo-on-dark.webp" width="128" height="52" alt="ECO-TOO – systemy ogrzewania na podczerwień" /></a>
    <button class="burger" aria-expanded="false" aria-controls="nav" id="burger"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>Menu</button>
    <nav class="main" id="nav" aria-label="Główna nawigacja">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={Astro.url.pathname.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a class="btn sm" href="/kontakt#formularz">Poproś o wycenę</a></li>
      </ul>
    </nav>
  </div></header>
  <main id="main"><slot /></main>
  <footer class="site"><div class="wrap">
    <div class="grid g3">
      <div>
        <img class="footer-logo" src="/logo-on-dark.webp" width="137" height="56" alt="ECO-TOO" loading="lazy" />
        <p>Projektujemy i montujemy ogrzewanie na podczerwień w Opolu i <a href="/obszar-dzialania">województwie opolskim</a>.</p>
        <p>NIP: {site.NIP}</p>
      </div>
      <div>
        <h3>Kontakt</h3>
        <ul>
          <li>{site.street}, {site.postal} {site.city}</li>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.hours}</li>
          <li><a href={site.reviewUrl} rel="noopener" target="_blank">Opinie w Google</a></li>
        </ul>
      </div>
      <div>
        <h3>Na skróty</h3>
        <ul>
          {nav.slice(0, 4).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/ogrzewanie-alternatywne">Ogrzewanie alternatywne</a></li>
          <li><a href="/tanie-ogrzewanie-domu">Tanie ogrzewanie – koszty</a></li>
          <li><a href="/kalkulator">Kalkulator kosztów</a></li>
          <li><a href="/obszar-dzialania">Obszar działania</a></li>
          <li><a href="/kontakt">Kontakt i wycena</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {new Date().getFullYear()} ECO-TOO. Wszelkie prawa zastrzeżone.</span>
      <a href="/polityka-prywatnosci">Polityka prywatności i cookies</a>
      <Analytics />
    </div>
  </div></footer>
  <a class="mobile-call" href={site.phoneHref}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Zadzwoń: {site.phone}</a>
  <dialog class="lb" id="lb" aria-label="Podgląd zdjęcia">
    <figure style="margin:0"><img id="lb-img" alt="" /><figcaption id="lb-cap"></figcaption></figure>
    <button class="x" aria-label="Zamknij" id="lb-x">×</button>
    <button class="nav prev" aria-label="Poprzednie" id="lb-p">‹</button>
    <button class="nav next" aria-label="Następne" id="lb-n">›</button>
  </dialog>
  <script>
    const b = document.getElementById('burger')!, n = document.getElementById('nav')!;
    b.addEventListener('click', () => { const o = n.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
    const lb = document.getElementById('lb') as HTMLDialogElement;
    const li = document.getElementById('lb-img') as HTMLImageElement, lc = document.getElementById('lb-cap')!;
    let list: HTMLButtonElement[] = [], idx = 0;
    const show = (i: number) => { idx = (i + list.length) % list.length; li.src = list[idx].dataset.full!; li.alt = lc.textContent = list[idx].dataset.alt!; };
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
      const items = Array.from(g.querySelectorAll<HTMLButtonElement>('button'));
      items.forEach((it, i) => it.addEventListener('click', () => { list = items; show(i); lb.showModal(); }));
    });
    document.getElementById('lb-x')!.onclick = () => lb.close();
    document.getElementById('lb-p')!.onclick = () => show(idx - 1);
    document.getElementById('lb-n')!.onclick = () => show(idx + 1);
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(idx - 1); if (e.key === 'ArrowRight') show(idx + 1); });
  </script>
</body>
</html>
